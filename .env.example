# --- Required -----------------------------------------------------------------
# Dawarich URL and API key (Dawarich: Settings → API key)
DAWARICH_URL=https://dawarich.example.com
DAWARICH_API_KEY=

# --- Optional -----------------------------------------------------------------
# Time zone for the nightly run time and for times shown in the UI.
TZ=Europe/Berlin
NIGHTLY_RUN_TIME=04:00

# trainlog login for downloading the trip export every night.
# Leave empty to only use CSVs uploaded in the web UI.
# Must be the username (not the email address): it's part of the export URL.
TRAINLOG_USERNAME=
TRAINLOG_PASSWORD=
# TRAINLOG_URL=https://trainlog.me

# Email when a run has warnings or errors. Leave SMTP_HOST empty for no emails.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), ssl (usually port 465) or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME
EMAIL_FROM=
EMAIL_TO=
# Address of this web UI, for links in emails, e.g. http://homelab:8000
APP_URL=

# Safety limit: a run that would delete more phone points than this deletes none
# and reports an error. Raise it once for the first run over your whole history.
MAX_PHONE_POINTS_DELETED_PER_RUN=5000

# Warn if the iOS Shortcut sent no point for this long (it should send every 15 minutes).
SHORTCUT_MAX_SILENCE_MINUTES=60
