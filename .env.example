# --- Required -----------------------------------------------------------------
# Dawarich URL and API key (Dawarich: Settings → API key)
DAWARICH_URL=https://dawarich.example.com
DAWARICH_API_KEY=

# --- Optional -----------------------------------------------------------------
# Port of the web UI (in the container and on the host, see docker-compose.example.yml)
PORT=8000

# Time zone for the nightly run time and for times shown in the UI.
TZ=Europe/Berlin
NIGHTLY_RUN_TIME=04:00

# trainlog login for downloading the trip export every night.
# Leave empty to only use CSVs uploaded in the web UI.
# Must be the username (not the email address): it's part of the export URL.
TRAINLOG_USERNAME=
TRAINLOG_PASSWORD=
# TRAINLOG_URL=https://trainlog.me

# Email when a run has warnings or errors. Leave SMTP_HOST empty for no emails.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), ssl (usually port 465) or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME
EMAIL_FROM=
EMAIL_TO=
# Address of this web UI, for links in emails, e.g. http://homelab:8000 (with your PORT)
APP_URL=

# Safety limit: a run that would delete more phone points than this deletes none
# and reports an error. Raise it once for the first run over your whole history.
MAX_PHONE_POINTS_DELETED_PER_RUN=5000

# Warn if the iOS Shortcut sent no point for this long (it should send every 15 minutes).
SHORTCUT_MAX_SILENCE_MINUTES=60

# --- Tuning (optional) --------------------------------------------------------
# Defaults shown. To apply a change: `docker compose up -d` (a plain restart keeps the old values).

# How closely the points sent to Dawarich follow a trip's route, in meters: a point of the route is
# left out if the line between its neighbours stays within this distance. Smaller follows curves
# better, with more points. Changing the drawn trips' value sends all drawn trips again on the next
# run. The trainlog value only applies to trips sent from then on (new or changed in trainlog): sending
# all of them again would rebuild their tracks and lose the mode corrections made in Dawarich.
DRAWN_TRIP_ROUTE_TOLERANCE_METERS=2
TRAINLOG_ROUTE_TOLERANCE_METERS=25
# On top of that, a point is kept at least this often (same rules as above).
ROUTE_CHECKPOINT_SECONDS=120

# Which phone points are deleted for a trip: all recorded during the trip, plus those up to
# PHONE_POINTS_TIME_BUFFER_MINUTES before/after it that lie within
# PHONE_POINTS_MAX_DISTANCE_FROM_ROUTE_METERS of the route, except those within STATION_RADIUS_METERS
# of where the trip starts or ends (waiting there, or your walk starting). Trips of the last
# RECHECK_DAYS days are checked again every run, so a larger value deletes more for those trips on the
# next run; a smaller one doesn't bring points back (they're in deleted-points/).
PHONE_POINTS_TIME_BUFFER_MINUTES=3
PHONE_POINTS_MAX_DISTANCE_FROM_ROUTE_METERS=50
STATION_RADIUS_METERS=150
RECHECK_DAYS=30
# Nothing is deleted for a trip if most phone points during it are this far from the route
# (the trip's time is probably wrong).
WRONG_TRIP_TIME_DISTANCE_METERS=1000

# Safety limit: if more trips than this are missing from one trainlog export, none are removed from
# Dawarich (the download was probably incomplete).
MAX_TRIPS_REMOVED_PER_RUN=10
